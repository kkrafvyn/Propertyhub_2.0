{
  "name": "@figma/my-make-file",
  "private": true,
  "version": "0.0.1",
  "description": "BaytMiftah property operations platform",
  "author": "BaytMiftah",
  "main": "electron/main.cjs",
  "type": "module",
  "scripts": {
    "build": "vite build",
    "build:vercel": "node scripts/vercel-build.mjs",
    "build:marketing": "cross-env VITE_SITE_MODE=marketing VITE_SITE_URL=https://baytmiftah.com VITE_APP_ORIGIN=https://propertyhub-2-0-ecru.vercel.app vite build",
    "build:web": "vite build",
    "dev": "vite",
    "dev:marketing": "cross-env VITE_SITE_MODE=marketing VITE_SITE_URL=https://baytmiftah.com VITE_APP_ORIGIN=https://propertyhub-2-0-ecru.vercel.app vite",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "security:dependency-audit": "npm audit --audit-level=high",
    "security:sast": "node scripts/security/run-sast.mjs",
    "security:sca": "node scripts/security/run-sca.mjs",
    "security:secrets": "node scripts/security/run-secrets.mjs",
    "security:actions-audit": "node scripts/security/audit-workflows.mjs",
    "security:unit": "node scripts/security/run-security-unit.mjs",
    "security:tenant": "node scripts/security/run-tenant-isolation.mjs",
    "security:summary": "node scripts/security/security-summary.mjs",
    "security:dast:validate-target": "node scripts/security/validate-dast-target.mjs",
    "security:install-tools": "node scripts/security/install-security-tools.mjs",
    "security:tools": "node scripts/security/check-security-tools.mjs",
    "security:container": "node scripts/security/run-container-scan.mjs",
    "security:branch-protection": "node scripts/security/apply-branch-protection.mjs",
    "security:all": "node scripts/security/run-security-all.mjs",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "i18n:generate": "node scripts/generate-locale-chrome.mjs",
    "integrations:wire": "node scripts/wire-integrations.mjs",
    "supabase:cleanup-secrets": "node scripts/cleanup-supabase-secrets.cjs",
    "cap:sync": "node scripts/mobile-sync.mjs consumer",
    "mobile:consumer:sync": "node scripts/mobile-sync.mjs consumer",
    "mobile:business:sync": "node scripts/mobile-sync.mjs business",
    "mobile:business:provision": "node scripts/provision-mobile-business.mjs",
    "mobile:consumer:install": "node scripts/mobile-sync.mjs consumer && node scripts/mobile-install.mjs consumer",
    "mobile:business:install": "node scripts/mobile-sync.mjs business && node scripts/mobile-install.mjs business",
    "mobile:consumer:bundle": "node scripts/mobile-sync.mjs consumer && node scripts/mobile-install.mjs consumer bundle",
    "mobile:business:bundle": "node scripts/mobile-sync.mjs business && node scripts/mobile-install.mjs business bundle",
    "android:consumer:open": "node scripts/mobile-sync.mjs consumer && npx cap open android",
    "android:business:open": "node scripts/mobile-sync.mjs business && npx cap open android",
    "android:add": "npx cap add android",
    "android:sync": "node scripts/mobile-sync.mjs consumer",
    "android:open": "node scripts/mobile-sync.mjs consumer && npx cap open android",
    "android:gradle:debug": "cd android && gradlew.bat assembleDebug",
    "android:build": "node scripts/mobile-sync.mjs consumer && cd android && gradlew.bat assembleDebug",
    "android:bundle:release": "node scripts/mobile-sync.mjs consumer && cd android && gradlew.bat bundleRelease",
    "android:apk:release": "node scripts/mobile-sync.mjs consumer && cd android && gradlew.bat assembleRelease",
    "ios:add": "npx cap add ios",
    "ios:sync": "node scripts/mobile-sync.mjs consumer",
    "ios:open": "node scripts/mobile-sync.mjs consumer && npx cap open ios",
    "ios:build:sim": "cd ios/App && xcodebuild -project App.xcodeproj -scheme App -configuration Debug -destination 'generic/platform=iOS Simulator' build",
    "mobile:release": "node scripts/build-mobile-release.mjs",
    "desktop:start": "electron electron/main.cjs",
    "desktop:dev": "concurrently -k \"cross-env VITE_DESKTOP_WORKSPACE_ONLY=true npm run dev\" \"wait-on http://localhost:5173 && cross-env ELECTRON_START_URL=http://localhost:5173 electron electron/main.cjs\"",
    "desktop:build": "npm run build:desktop && electron electron/main.cjs",
    "build:desktop": "cross-env ELECTRON_BUILD=true VITE_DESKTOP_WORKSPACE_ONLY=true vite build",
    "desktop:icons": "node scripts/generate-desktop-icon.mjs",
    "desktop:pack:win": "npm run desktop:icons && npm run build:desktop && cross-env CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --win --dir --x64 && node scripts/patch-desktop-exe-icon.mjs && cross-env CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --win --x64 --publish never --prepackaged dist-desktop/win-unpacked",
    "desktop:publish": "node scripts/publish-desktop-installer.mjs",
    "desktop:release": "npm run desktop:pack:win && npm run desktop:publish",
    "docker:build": "docker build -t baytmiftah/web:local .",
    "docker:up": "docker compose --profile staging up --build -d",
    "docker:down": "docker compose --profile staging down",
    "supabase:login": "powershell -ExecutionPolicy Bypass -File scripts/supabase-login.ps1",
    "supabase:deploy:payments": "node scripts/deploySupabasePayments.cjs --skip-db",
    "supabase:secrets:resend": "node scripts/configure-resend-secrets.cjs",
    "supabase:configure-auth": "node scripts/configure-supabase-auth.mjs",
    "db:status": "node scripts/supabase-db.mjs status",
    "db:query": "node scripts/supabase-db.mjs query",
    "db:push": "node scripts/supabase-db.mjs push",
    "jobs:recurring-charges": "node scripts/workers/generate-recurring-charges.mjs",
    "jobs:verify-collection-promises": "node scripts/workers/verify-collection-promises.mjs",
    "jobs:process-automation-events": "node scripts/workers/process-automation-events.mjs",
    "jobs:night-watch": "node scripts/workers/night-watch-audit.mjs",
    "jobs:owner-statements": "node scripts/workers/process-owner-statement-deliveries.mjs",
    "jobs:communications": "node scripts/workers/process-communication-queue.mjs",
    "jobs:retention": "node scripts/workers/apply-data-retention.mjs",
    "ops:health": "node scripts/ops/health-check.mjs",
    "jobs:run-all": "node scripts/workers/run-all-jobs.mjs",
    "production:check": "node scripts/production-check.mjs",
    "db:types": "node scripts/generate-database-types.mjs",
    "worker:estate-operations": "node scripts/workers/estate-operations-worker.mjs",
    "backup": "node scripts/backup/create-backup.mjs",
    "backup:db": "node scripts/backup/create-backup.mjs -- --db-only",
    "backup:storage": "node scripts/backup/create-backup.mjs -- --storage-only",
    "backup:list": "node scripts/backup/list-backups.mjs",
    "backup:restore-drill": "node scripts/backup/restore-drill.mjs",
    "security:tenant-fixtures": "node scripts/security/seed-tenant-isolation-fixtures.mjs",
    "security:provision-tenant-fixtures": "node scripts/security/provision-tenant-isolation-fixtures.mjs",
    "security:grant-platform-admin": "node scripts/security/grant-platform-admin.mjs",
    "backup:restore-drill:fixture": "node scripts/backup/restore-drill.mjs -- --path scripts/backup/fixtures/minimal-backup",
    "backup:offsite": "node scripts/backup/run-offsite-backup.mjs -- --auto-tier",
    "backup:offsite:db": "node scripts/backup/run-offsite-backup.mjs -- --db-only --auto-tier",
    "backup:pre-migration": "node scripts/backup/run-offsite-backup.mjs -- --label pre-migration --tier pre-migration --verify-db",
    "backup:pre-migration:local": "node scripts/backup/run-offsite-backup.mjs -- --label pre-migration --tier pre-migration --skip-upload --verify-db",
    "backup:upload": "node scripts/backup/upload-offsite.mjs",
    "backup:retention:apply": "node scripts/backup/apply-retention.mjs",
    "backup:restore-drill:verify": "node scripts/backup/restore-drill.mjs -- --verify-db --write-evidence",
    "vercel:env": "node scripts/sync-vercel-env.mjs",
    "contracts:install": "npm install --prefix blockchain",
    "contracts:build": "npm run build --prefix blockchain",
    "contracts:deploy-all": "npm run build --prefix blockchain && npm exec --prefix blockchain -- hardhat run ../scripts/deployAll.cjs --network polygonAmoy",
    "contracts:deploy-all-mainnet": "npm run build --prefix blockchain && npm exec --prefix blockchain -- hardhat run ../scripts/deployAll.cjs --network polygonMainnet",
    "contracts:deploy-token": "npm run build --prefix blockchain && npm exec --prefix blockchain -- hardhat run ../scripts/deployPropertyToken.cjs --network polygonAmoy",
    "contracts:deploy-escrow": "npm run build --prefix blockchain && npm exec --prefix blockchain -- hardhat run ../scripts/deployPropertyEscrow.cjs --network polygonAmoy",
    "contracts:deploy-ownership": "npm run build --prefix blockchain && npm exec --prefix blockchain -- hardhat run ../scripts/deployPropertyOwnership.cjs --network polygonAmoy",
    "contracts:deploy-lease": "npm run build --prefix blockchain && npm exec --prefix blockchain -- hardhat run ../scripts/deployPropertyLease.cjs --network polygonAmoy",
    "contracts:deploy-verification-registry": "npm run build --prefix blockchain && npm exec --prefix blockchain -- hardhat run ../scripts/deployVerificationRegistry.cjs --network polygonAmoy",
    "contracts:test": "npm run test --prefix blockchain",
    "contracts:verify": "npm run verify --prefix blockchain"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.1",
    "@capacitor/camera": "^8.2.2",
    "@capacitor/core": "^8.3.4",
    "@capacitor/geolocation": "^8.2.2",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/ios": "^8.3.4",
    "@emotion/react": "11.14.0",
    "@emotion/styled": "11.14.1",
    "@mui/icons-material": "7.3.5",
    "@mui/material": "7.3.5",
    "@openzeppelin/contracts": "^5.6.1",
    "@popperjs/core": "2.11.8",
    "@radix-ui/react-accordion": "1.2.3",
    "@radix-ui/react-alert-dialog": "1.1.6",
    "@radix-ui/react-aspect-ratio": "1.1.2",
    "@radix-ui/react-avatar": "1.1.3",
    "@radix-ui/react-checkbox": "1.1.4",
    "@radix-ui/react-collapsible": "1.1.3",
    "@radix-ui/react-context-menu": "2.2.6",
    "@radix-ui/react-dialog": "1.1.6",
    "@radix-ui/react-dropdown-menu": "2.1.6",
    "@radix-ui/react-hover-card": "1.1.6",
    "@radix-ui/react-label": "2.1.2",
    "@radix-ui/react-menubar": "1.1.6",
    "@radix-ui/react-navigation-menu": "1.2.5",
    "@radix-ui/react-popover": "1.1.6",
    "@radix-ui/react-progress": "1.1.2",
    "@radix-ui/react-radio-group": "1.2.3",
    "@radix-ui/react-scroll-area": "1.2.3",
    "@radix-ui/react-select": "2.1.6",
    "@radix-ui/react-separator": "1.1.2",
    "@radix-ui/react-slider": "1.2.3",
    "@radix-ui/react-slot": "1.1.2",
    "@radix-ui/react-switch": "1.1.3",
    "@radix-ui/react-tabs": "1.1.3",
    "@radix-ui/react-toggle": "1.1.2",
    "@radix-ui/react-toggle-group": "1.1.2",
    "@radix-ui/react-tooltip": "1.1.8",
    "@supabase/supabase-js": "^2.110.8",
    "canvas-confetti": "1.9.4",
    "capacitor-native-biometric": "^4.2.2",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "date-fns": "3.6.0",
    "embla-carousel-react": "8.6.0",
    "ethers": "^6.10.0",
    "input-otp": "1.4.2",
    "leaflet": "^1.9.4",
    "lucide-react": "0.487.0",
    "motion": "12.23.24",
    "next-themes": "0.4.6",
    "react": "19.2.7",
    "react-day-picker": "8.10.1",
    "react-dnd": "16.0.1",
    "react-dnd-html5-backend": "16.0.1",
    "react-dom": "19.2.7",
    "react-hook-form": "7.55.0",
    "react-leaflet": "^4.2.1",
    "react-popper": "2.3.0",
    "react-resizable-panels": "2.1.7",
    "react-responsive-masonry": "2.7.1",
    "react-router": "8.3.0",
    "react-slick": "0.31.0",
    "recharts": "2.15.2",
    "sonner": "2.0.3",
    "tailwind-merge": "3.2.0",
    "tw-animate-css": "1.3.8",
    "vaul": "1.1.2"
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "^3.1126.0",
    "@capacitor/cli": "^8.3.4",
    "@playwright/test": "^1.55.0",
    "@tailwindcss/vite": "4.1.12",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/leaflet": "^1.9.21",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "4.7.0",
    "chai": "^4.3.10",
    "concurrently": "^10.0.5",
    "cross-env": "^10.1.0",
    "electron": "^43.4.0",
    "electron-builder": "^25.1.8",
    "google-translate-api-x": "^10.7.3",
    "happy-dom": "^20.11.0",
    "jsdom": "^26.1.0",
    "pg": "^8.22.0",
    "png-to-ico": "^3.0.2",
    "rcedit": "^4.0.1",
    "sharp": "^0.35.4",
    "supabase": "^2.112.0",
    "tailwindcss": "4.1.12",
    "typescript": "^5.8.3",
    "vite": "6.4.3",
    "vitest": "^3.2.7",
    "wait-on": "^9.1.0",
    "web-push": "^3.6.7"
  },
  "optionalDependencies": {
    "better-sqlite3": "^11.10.0"
  },
  "peerDependencies": {
    "react": "19.2.7",
    "react-dom": "19.2.7"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "overrides": {
    "vite": "6.4.3",
    "cookie": "^0.7.2",
    "ws": "^8.21.1",
    "tmp": "^0.2.7",
    "brace-expansion": "^5.0.9",
    "serialize-javascript": "^7.0.7",
    "undici": "^7.16.0",
    "uuid": "^11.1.1",
    "diff": "^8.0.3",
    "adm-zip": "^0.6.0",
    "bn.js": "^5.2.2"
  },
  "build": {
    "appId": "com.baytmiftah.desktop",
    "productName": "BaytMiftah Workspace",
    "directories": {
      "output": "dist-desktop",
      "buildResources": "electron/build"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "asar": true,
    "asarUnpack": [
      "**/node_modules/better-sqlite3/**"
    ],
    "icon": "electron/build/icon.png",
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "electron/build/icon.ico",
      "artifactName": "baytmiftah-desktop-setup.${ext}",
      "signAndEditExecutable": false,
      "signDlls": false,
      "verifyUpdateCodeSignature": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "allowElevation": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "installerIcon": "electron/build/icon.ico",
      "uninstallerIcon": "electron/build/icon.ico"
    }
  }
}
