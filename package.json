  "build": {
    "appId": "com.baytmiftah.desktop",
    "productName": "BaytMiftah Workspace",
    "directories": {
      "output": "dist-desktop",
      "buildResources": "electron/build"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "asar": true,
    "npmRebuild": false,
    "buildDependenciesFromSource": false,
    "asarUnpack": [
      "**/node_modules/better-sqlite3/**"
    ],
    "icon": "electron/build/icon.png",
    "protocols": [
      {
        "name": "BaytMiftah Auth",
        "schemes": [
          "baytmiftah"
        ]
      }
    ],
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "universal"
          ]
        }
      ],
      "category": "public.app-category.business",
      "minimumSystemVersion": "12.0",
      "files": [
        "dist/**/*",
        "electron/**/*",
        "package.json",
        "!node_modules/**"
      ],
      "extendInfo": {
        "NSCameraUsageDescription": "BaytMiftah uses your camera when you choose to capture property or verification documents.",
        "NSLocationUsageDescription": "BaytMiftah uses your location when you choose location-based property services."
      },
      "artifactName": "baytmiftah-desktop-${version}-${arch}.${ext}"
    },
    "mas": {
      "target": [
        {
          "target": "mas",
          "arch": [
            "universal"
          ]
        }
      ],
      "appId": "com.baymiftah.workspace",
      "type": "distribution",
      "hardenedRuntime": false,
      "bundleShortVersion": "1.0.0",
      "bundleVersion": "1",
      "files": [
        "dist/**/*",
        "electron/**/*",
        "package.json",
        "!node_modules/**"
      ],
      "extendInfo": {
        "ElectronTeamID": "7T2JK53K5M",
        "ITSAppUsesNonExemptEncryption": false,
        "NSCameraUsageDescription": "BaytMiftah uses your camera when you choose to capture property or verification documents.",
        "NSLocationUsageDescription": "BaytMiftah uses your location when you choose location-based property services."
      },
      "entitlements": "electron/build/entitlements.mas.plist",
      "entitlementsInherit": "electron/build/entitlements.mas.inherit.plist",
      "entitlementsLoginHelper": "electron/build/entitlements.mas.plist",
      "artifactName": "baytmiftah-workspace-${version}-mas-${arch}.${ext}"
    },
