{
  "name": "@figma/my-make-file",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "build": "vite build",
    "build:web": "vite build",
    "dev": "vite",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "i18n:generate": "node scripts/generate-locale-chrome.mjs",
    "integrations:wire": "node scripts/wire-integrations.mjs",
    "supabase:cleanup-secrets": "node scripts/cleanup-supabase-secrets.cjs",
    "cap:sync": "npx cap sync",
    "android:add": "npx cap add android",
    "android:sync": "npm run build:web && npx cap sync android",
    "android:open": "npx cap open android",
    "android:gradle:debug": "cd android && gradlew.bat assembleDebug",
    "android:build": "npm run android:sync && npm run android:gradle:debug",
    "ios:add": "npx cap add ios",
    "ios:sync": "npm run build:web && npx cap sync ios",
    "ios:open": "npx cap open ios",
    "ios:build:sim": "cd ios/App && xcodebuild -project App.xcodeproj -scheme App -configuration Debug -destination 'generic/platform=iOS Simulator' build",
    "supabase:login": "powershell -ExecutionPolicy Bypass -File scripts/supabase-login.ps1",
    "supabase:deploy:payments": "node scripts/deploySupabasePayments.cjs --skip-db",
    "supabase:configure-auth": "node scripts/configure-supabase-auth.mjs",
    "db:status": "node scripts/supabase-db.mjs status",
    "db:query": "node scripts/supabase-db.mjs query",
    "db:push": "node scripts/supabase-db.mjs push",
    "db:types": "node scripts/generate-database-types.mjs",
    "backup": "node scripts/backup/create-backup.mjs",
    "backup:db": "node scripts/backup/create-backup.mjs -- --db-only",
    "backup:storage": "node scripts/backup/create-backup.mjs -- --storage-only",
    "backup:list": "node scripts/backup/list-backups.mjs",
    "vercel:env": "node scripts/sync-vercel-env.mjs",
    "contracts:install": "npm install --prefix blockchain",
    "contracts:build": "npm run build --prefix blockchain",
    "contracts:deploy-all": "npm run build --prefix blockchain && npm exec --prefix blockchain -- hardhat run ../scripts/deployAll.cjs --network polygonAmoy",
    "contracts:deploy-all-mainnet": "npm run build --prefix blockchain && npm exec --prefix blockchain -- hardhat run ../scripts/deployAll.cjs --network polygonMainnet",
    "contracts:deploy-token": "npm run build --prefix blockchain && npm exec --prefix blockchain -- hardhat run ../scripts/deployPropertyToken.cjs --network polygonAmoy",
    "contracts:deploy-escrow": "npm run build --prefix blockchain && npm exec --prefix blockchain -- hardhat run ../scripts/deployPropertyEscrow.cjs --network polygonAmoy",
    "contracts:deploy-ownership": "npm run build --prefix blockchain && npm exec --prefix blockchain -- hardhat run ../scripts/deployPropertyOwnership.cjs --network polygonAmoy",
    "contracts:deploy-lease": "npm run build --prefix blockchain && npm exec --prefix blockchain -- hardhat run ../scripts/deployPropertyLease.cjs --network polygonAmoy",
    "contracts:deploy-verification-registry": "npm run build --prefix blockchain && npm exec --prefix blockchain -- hardhat run ../scripts/deployVerificationRegistry.cjs --network polygonAmoy",
    "contracts:test": "npm run test --prefix blockchain",
    "contracts:verify": "npm run verify --prefix blockchain"
  },
