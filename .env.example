# =============================================================================
# BaytMiftah — ALL environment variables (single file)
# Copy to .env and fill in values:
#   cp .env.example .env
#
# Vercel upload: paste only the VITE_* section into Project → Environment Variables
# Supabase deploy: npm run integrations:wire && npm run supabase:deploy:payments -- --skip-db
# =============================================================================

# ── Supabase project (required) ─────────────────────────────────────────────
# Project ref (eu-west-1): ixmbfnfwpjwbfahqaftc — public URL pattern below.
# Fetch anon/publishable keys: Dashboard → Project Settings → API, or (when CLI works):
#   npx supabase projects api-keys --project-ref ixmbfnfwpjwbfahqaftc
# Never commit SUPABASE_SERVICE_ROLE_KEY; set only in local .env / GitHub / Supabase secrets.
SUPABASE_PROJECT_REF=ixmbfnfwpjwbfahqaftc
VITE_SUPABASE_URL=https://ixmbfnfwpjwbfahqaftc.supabase.co
VITE_SUPABASE_ANON_KEY=
VITE_SUPABASE_PUBLISHABLE_KEY=

# ── Supabase CLI / database scripts ─────────────────────────────────────────
# Token: https://supabase.com/dashboard/account/tokens
SUPABASE_ACCESS_TOKEN=
SUPABASE_DB_PASSWORD=
SUPABASE_DB_REGION=eu-west-1
SUPABASE_DB_PORT=5432
# Optional Supabase root CA certificate, relative to the repository root.
# SUPABASE_DB_SSL_ROOT_CERT=supabase/certs/prod-ca-2021.crt
# Optional full override:
# SUPABASE_DB_URL=postgresql://postgres.your-ref:password@aws-0-eu-west-1.pooler.supabase.com:5432/postgres
# Service role key — required for storage backups & admin scripts (never expose client-side)
SUPABASE_SERVICE_ROLE_KEY=

# ── Production safety (required default) ──────────────────────────────────────
# Must stay false in production — demo data bypasses real tenant boundaries.
VITE_ENABLE_DEMO_DATA=false
# Operator attestation after completing LEGAL_LAUNCH_CHECKLIST (docs/legal/LEGAL_LAUNCH_SIGNOFF.md)
LEGAL_LAUNCH_SIGNED_OFF=false
# Optional client mirror for in-app badges (must match operator sign-off)
VITE_LEGAL_LAUNCH_SIGNED_OFF=false
# Public legal entity (production — replace placeholders)
VITE_LEGAL_COMPANY_NAME=BaytMiftah
VITE_LEGAL_REGISTERED_ADDRESS=Accra, Ghana
VITE_LEGAL_REGISTRATION_NUMBER=
VITE_LEGAL_EMAIL=support@baytmiftah.com
VITE_PRIVACY_EMAIL=support@baytmiftah.com
VITE_DPO_EMAIL=support@baytmiftah.com
VITE_SUPPORT_EMAIL=support@baytmiftah.com
# Repo-only gate (npm run production:check:repo): score integrations without live secrets — ready stays false until configured
PRODUCTION_INTEGRATIONS_DEFERRED=false
# Defer Resend + ops webhook + S3 backup in npm run production:check until keys exist (PayAngels + service role still required)
INTEGRATIONS_LAUNCH_DEFERRED=false
# Repo-only gate: defer legal sign-off scoring — do not set true in production without counsel sign-off
LEGAL_LAUNCH_DEFERRED=false
# Deprecated — production builds ignore demo data; use live Supabase-backed services only

# ── Tenant isolation CI fixtures (optional — staging Supabase project) ───────
# When all four are set, tenant-isolation.test.ts signs in fixture users and runs live RLS proofs.
# See scripts/security/seed-tenant-isolation-fixtures.mjs
VITE_SUPABASE_TEST_URL=
VITE_SUPABASE_TEST_ANON_KEY=
VITE_SUPABASE_TEST_TENANT_A_ID=
VITE_SUPABASE_TEST_TENANT_B_ID=
# TENANT_FIXTURE_PASSWORD=  # optional override; defaults to provision script password

# ── Desktop installer ───────────────────────────────────────────────────────
# Optional CDN URL for the workspace desktop installer (web gateway download button)
# VITE_DESKTOP_DOWNLOAD_URL=https://your-cdn/baytmiftah-desktop-setup.exe
# Desktop .exe build sets automatically: ELECTRON_BUILD=true VITE_DESKTOP_WORKSPACE_ONLY=true
# Local after `npm run desktop:release`: /downloads/baytmiftah-desktop-setup.exe

# ── DAST (staging only — never production) ───────────────────────────────────
# DAST_TARGET_URL=https://staging.example.com
# DAST_TEST_EMAIL=
# DAST_TEST_PASSWORD=
# DAST_SUPABASE_URL=
# DAST_SUPABASE_ANON_KEY=

# ── App URLs & versioning (client / Vercel) ─────────────────────────────────
# Product app (login, workspace, consumer routes) — baytmiftah-app on Vercel
VITE_PUBLIC_APP_URL=https://app.baytmiftah.com
# Marketing site (homepage, legal) — baytmiftah-marketing on Vercel
VITE_SITE_URL=https://www.baytmiftah.com
# CTAs from marketing builds (defaults to VITE_PUBLIC_APP_URL when unset)
VITE_APP_ORIGIN=https://app.baytmiftah.com
# Optional legacy/preview app URL (Supabase redirects + ALLOWED_ORIGINS); omit in production if unused
# VERCEL_PUBLIC_APP_URL=https://your-preview.vercel.app
# Optional comma-separated extra Supabase auth redirect origins (no trailing slash)
# SUPABASE_EXTRA_REDIRECT_URLS=https://my-preview.vercel.app
# Site mode: marketing (baytmiftah.com) | app (app.baytmiftah.com)
# Vercel baytmiftah-marketing project: set VITE_SITE_MODE=marketing OR use npm run build:marketing
VITE_SITE_MODE=
VITE_PROPERTY_MEDIA_BUCKET=property-media
VITE_APP_VERSION=1.0.0
VITE_APP_BUILD_NUMBER=1
VITE_APP_MINIMUM_VERSION=1.0.0
VITE_APP_MIN_VERSION=
VITE_APP_LATEST_VERSION=
VITE_APP_FORCE_UPDATE=false
# Set VITE_APP_UPDATE_REMOTE=true to always call the app-version edge function
VITE_APP_UPDATE_REMOTE=
# Set VITE_APP_UPDATE_SOURCE=local to skip remote checks (uses env vars only)
VITE_APP_UPDATE_SOURCE=
VITE_APP_CHANGELOG=

# ── Sign in with Apple (Supabase provider secret = JWT, not the .p8) ─────────
# Generate JWT: npm run apple:client-secret
# Paste JWT into Supabase → Auth → Providers → Apple → Secret Key
# Client ID in Supabase = APPLE_SERVICES_ID
# APPLE_TEAM_ID=
# APPLE_KEY_ID=
# APPLE_SERVICES_ID=com.baymiftah.web
# APPLE_PRIVATE_KEY_PATH=./secrets/AuthKey_XXXXXXXXXX.p8
# Optional (default ~6 months): APPLE_JWT_TTL_SECONDS=15777000

# ── Offsite backup / disaster recovery (AWS S3) ─────────────────────────────
# Dedicated bucket — never reuse Supabase storage or production app buckets.
BACKUP_S3_BUCKET=
BACKUP_S3_PREFIX=baytmiftah
AWS_REGION=eu-west-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Optional SSE-KMS key (otherwise S3 AES256 encryption is used):
# BACKUP_KMS_KEY_ID=

# ── Native mobile store links (Capacitor) ───────────────────────────────────
VITE_IOS_APP_URL=
VITE_ANDROID_APP_URL=

# ── PayAngels (sole payment rail — MoMo, bank, card) ─────────────────────────
# Public key → Vercel (client inline checkout)
VITE_PAYANGELS_PUBLIC_KEY=
# Set true after npm run integrations:wire-payangels (sync to Vercel via npm run vercel:env)
VITE_PAYANGELS_CONFIGURED=false
# Server secrets → Supabase (npm run supabase:deploy:payments)
PAYANGELS_SECRET_KEY=
PAYANGELS_WEBHOOK_SECRET=
# PayAngel provides private API documentation and endpoints after the business channel is live.
# Never point these values at Paystack or another provider.
PAYANGELS_API_BASE=
PAYANGELS_DISBURSEMENT_URL=
# Set only after the implementation has been checked against PayAngel's private API contract.
PAYANGELS_API_CONTRACT_VERIFIED=false
# Set only after a complete certification run (init, webhook, refund, and payout).
PAYANGELS_LIVE_CERTIFIED=false
# Optional override for email header logo (defaults to {PUBLIC_APP_URL}/brand/email-logo.svg)
EMAIL_LOGO_URL=
# Optional: exchangerate-api.com key (public API fallback exists)
EXCHANGE_RATE_API_KEY=
# Staging E2E (npm run pilot:payangels-e2e)
PAYANGELS_SANDBOX_WEBHOOK_SECRET=
PAYANGELS_SANDBOX_TEST_REFERENCE=
PAYANGELS_SANDBOX_AMOUNT_MINOR=25000
# Pilot E2E probes (optional — npm run pilot:payangels-e2e)
PILOT_TEST_USER_EMAIL=
PILOT_TEST_USER_PASSWORD=
PILOT_TEST_LISTING_ID=
PILOT_TEST_TRANSACTION_ID=
PILOT_TEST_ORG_ID=
PILOT_TEST_APPROVAL_ID=
PILOT_TEST_DISBURSE_PHONE=
# Webhook URL: https://<project-ref>.supabase.co/functions/v1/payangels-webhook

# ── Bank feed providers (live sync — optional, Supabase secrets) ─────────────
# sync-bank-feed reads MONZO_FEED_* / GTBANK_FEED_* / FIDELITY_FEED_* / etc.
MONZO_FEED_BASE_URL=
MONZO_FEED_API_KEY=
GTBANK_FEED_BASE_URL=
GTBANK_FEED_API_KEY=
FIDELITY_FEED_BASE_URL=
FIDELITY_FEED_API_KEY=
STANDARD_CHARTERED_FEED_BASE_URL=
STANDARD_CHARTERED_FEED_API_KEY=
BANK_OF_GHANA_FEED_BASE_URL=
BANK_OF_GHANA_FEED_API_KEY=
# Legacy/alternate aggregators (optional)
MONO_SECRET_KEY=
MONO_WEBHOOK_SECRET=
PLAID_CLIENT_ID=
PLAID_SECRET=

# ── Web push (VAPID) ────────────────────────────────────────────────────────
# Run npm run integrations:wire to auto-generate the pair if empty
VITE_WEB_PUSH_PUBLIC_KEY=
WEB_PUSH_PUBLIC_KEY=
WEB_PUSH_PRIVATE_KEY=
WEB_PUSH_CONTACT_EMAIL=mailto:support@baytmiftah.com

# ── Email (Resend) ──────────────────────────────────────────────────────────
RESEND_API_KEY=
NOTIFICATION_EMAIL_FROM=noreply@baytmiftah.com
NOTIFICATION_EMAIL_REPLY_TO=support@baytmiftah.com
# Verify domain at https://resend.com/domains before pilot

# ── Automations (cron / internal dispatch) ───────────────────────────────────
# Auto-generated by npm run integrations:wire if empty
INTERNAL_AUTOMATIONS_KEY=

# ── Monitoring / alerting ───────────────────────────────────────────────────
# Slack/Discord webhook — notified when ops:health fails (GitHub Actions monitoring.yml)
OPS_ALERT_WEBHOOK_URL=
# Supabase Edge secret: exact deployed web-app URL for the admin health probe
APP_HEALTH_URL=https://app.baytmiftah.com
LOAD_TEST_BASE_URL=https://app.baytmiftah.com
LOAD_TEST_MAX_ERROR_RATE=0.05

# ── App URL for server callbacks (Supabase Edge) ─────────────────────────────
PUBLIC_APP_URL=https://baytmiftah.com

# ── Exchange rates (optional client hint) ───────────────────────────────────
VITE_EXCHANGE_RATE_API_KEY=

# ── DocuSign e-sign (optional — Supabase secrets) ───────────────────────────
DOCUSIGN_ACCOUNT_ID=
DOCUSIGN_ACCESS_TOKEN=
DOCUSIGN_BASE_URL=https://demo.docusign.net
VITE_DOCUSIGN_INTEGRATION_KEY=

# ── Integration flags (auto-set by npm run integrations:wire) ───────────────
VITE_OPENAI_ENABLED=
VITE_AI_ENABLED=
VITE_AI_PROVIDER=
VITE_RESEND_CONFIGURED=

# ── AI (optional — works without keys using guided help) ───────────────────────
# Provider: openai | qwen (auto-detected from keys if only one is set)
AI_PROVIDER=openai
# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1
# Qwen (Alibaba DashScope — OpenAI-compatible API)
QWEN_API_KEY=
QWEN_MODEL=qwen-plus
# QWEN_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1

# ── KYC — Smile Identity (Ghana / Africa) ─────────────────────────────────────
# Portal: https://portal.usesmileid.com
# Docs:   https://docs.usesmileid.com
SMILE_PARTNER_ID=
SMILE_API_KEY=
SMILE_ENVIRONMENT=sandbox
# Webhook: https://<project-ref>.supabase.co/functions/v1/kyc-smile-webhook
SMILE_CALLBACK_URL=

# ── KYC — Prembly (Supabase Edge secrets) ─────────────────────────────────────
# When true, npm run production:check treats missing Prembly keys as non-blocking.
PREMBLY_LIVE_KYC_OPTIONAL=false
# Confirm the exact endpoint path enabled for your Prembly account; do not guess it.
PREMBLY_API_KEY=
PREMBLY_APP_ID=
PREMBLY_PUBLIC_KEY=
PREMBLY_ORGANISATION_ID=
PREMBLY_BASE_URL=https://api.prembly.com
PREMBLY_VERIFICATION_PATH=
# Optional routing map, e.g. {"GH":"/contracted/path","GH:passport":"/contracted/passport/path"}
PREMBLY_VERIFICATION_PATHS_JSON=
# Public hosted-widget identifiers (safe for the browser; never put PREMBLY_API_KEY here)
VITE_PREMBLY_WIDGET_KEY=
VITE_PREMBLY_WIDGET_ID=

# ── KYC — alternative vendors (future) ────────────────────────────────────────
# SUMSUB_APP_TOKEN=
# SUMSUB_SECRET_KEY=
# SUMSUB_WEBHOOK_SECRET=

# ── Tenant screening (US) ─────────────────────────────────────────────────────
TRANSUNION_API_KEY=

# Hardhat / Polygon deployment. Keep the private key server/local only and use a
# dedicated deployer wallet with limited funds—never a personal wallet.
HARDHAT_DEPLOYER_PRIVATE_KEY=
HARDHAT_DEPLOYER_ADDRESS=
POLYGON_AMOY_RPC_URL=https://rpc-amoy.polygon.technology/
POLYGON_MAINNET_RPC_URL=https://polygon-rpc.com
POLYGONSCAN_API_KEY=
ALLOW_MAINNET_CONTRACT_DEPLOY=false

# ── App release / update notifications (Edge + client) ───────────────────────
# Bump VITE_APP_VERSION on each release; set APP_LATEST_VERSION in Supabase secrets
APP_LATEST_VERSION=
APP_MINIMUM_VERSION=
APP_FORCE_UPDATE=false
APP_CHANGELOG=
DESKTOP_DOWNLOAD_URL=

# ── MLS / listing syndication (optional) ─────────────────────────────────────
MLS_API_KEY=
# Full provider/RESO Web API collection endpoint. HTTPS is required.
MLS_FEED_URL=
# Key-only authentication: x-api-key (default), bearer, or query.
MLS_AUTH_MODE=x-api-key
MLS_API_KEY_HEADER=X-API-Key
MLS_API_KEY_QUERY_PARAM=api_key
ZILLOW_API_KEY=
ZILLOW_FEED_URL=
ZILLOW_AUTH_MODE=x-api-key
REALTOR_API_KEY=
REALTOR_FEED_URL=
REALTOR_AUTH_MODE=bearer

# ── Twilio SMS/WhatsApp (optional) ──────────────────────────────────────────
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_PHONE_NUMBER=
# TWILIO_SMS_FROM=
# TWILIO_WHATSAPP_FROM=

# ── Meta WhatsApp Cloud API (group bot + outbound) ───────────────────────────
# Set on Supabase Edge secrets (whatsapp-webhook, send-whatsapp). Never VITE_*.
# Webhook URL: https://<project-ref>.supabase.co/functions/v1/whatsapp-webhook
# WHATSAPP_VERIFY_TOKEN=          # Meta webhook verify (GET hub.verify_token)
# WHATSAPP_APP_SECRET=            # Validates X-Hub-Signature-256 on POST
# WHATSAPP_CLOUD_TOKEN=           # System user / permanent token for Graph API
# WHATSAPP_PHONE_NUMBER_ID=       # From Meta WhatsApp → API setup
# WHATSAPP_GRAPH_URL=https://graph.facebook.com/v21.0
# WHATSAPP_DEFAULT_ORG_ID=        # Optional fallback org UUID when one WABA serves a single estate

# ── Blockchain contract addresses (after Hardhat deploy) ─────────────────────
VITE_PROPERTY_TOKEN_ADDRESS=
VITE_PROPERTY_ESCROW_ADDRESS=
VITE_PROPERTY_OWNERSHIP_ADDRESS=
VITE_PROPERTY_LEASE_ADDRESS=
VITE_VERIFICATION_REGISTRY_ADDRESS=
VITE_BLOCKCHAIN_NETWORK=amoy
