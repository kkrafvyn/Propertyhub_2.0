# =============================================================================
# BaytMiftah — CLIENT environment template
# Copy to .env and fill in values.
#
#   cp .env.example .env
#
# Other env files:
#   supabase/.env.payments.example → supabase/.env.payments  (server secrets)
#   supabase/.env.local.example    → supabase/.env.local     (DB CLI access)
#   .env.vercel.example            → Vercel Production env vars
# =============================================================================

# ── Supabase (required) ──────────────────────────────────────────────────────
SUPABASE_PROJECT_REF=
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_SUPABASE_PUBLISHABLE_KEY=

# ── App URLs & versioning ────────────────────────────────────────────────────
VITE_PUBLIC_APP_URL=https://baytmiftah.com
VITE_SITE_URL=https://baytmiftah.com
VITE_PROPERTY_MEDIA_BUCKET=property-media
VITE_APP_VERSION=1.0.0
VITE_APP_BUILD_NUMBER=1
VITE_APP_MINIMUM_VERSION=1.0.0
VITE_APP_MIN_VERSION=
VITE_APP_LATEST_VERSION=
VITE_APP_FORCE_UPDATE=false
VITE_APP_CHANGELOG=

# ── Native mobile store links (Capacitor) ────────────────────────────────────
VITE_IOS_APP_URL=
VITE_ANDROID_APP_URL=

# ── Paystack — PUBLIC key only (pk_live_... / pk_test_...) ───────────────────
# Dashboard → Settings → API Keys & Webhooks → Public Key
# Secret key → supabase/.env.payments → PAYSTACK_SECRET_KEY
VITE_PAYSTACK_PUBLIC_KEY=

# ── Stripe — PUBLIC key only (pk_live_... / pk_test_...) ─────────────────────
# Dashboard → Developers → API keys → Publishable key
# Secret key → supabase/.env.payments → STRIPE_SECRET_KEY
VITE_STRIPE_PUBLIC_KEY=

# ── Web push — PUBLIC VAPID key ────────────────────────────────────────────────
# Pair with WEB_PUSH_* in supabase/.env.payments (run: npm run integrations:wire)
VITE_WEB_PUSH_PUBLIC_KEY=

# ── Exchange rates (optional) ────────────────────────────────────────────────
VITE_EXCHANGE_RATE_API_KEY=

# ── Integration flags (set true when server secret is configured) ────────────
VITE_OPENAI_ENABLED=
VITE_RESEND_CONFIGURED=

# ── Blockchain contract addresses (after Hardhat deploy) ─────────────────────
VITE_PROPERTY_TOKEN_ADDRESS=
VITE_PROPERTY_ESCROW_ADDRESS=
VITE_PROPERTY_OWNERSHIP_ADDRESS=
VITE_PROPERTY_LEASE_ADDRESS=
VITE_VERIFICATION_REGISTRY_ADDRESS=
