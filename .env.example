# BaytMiftah environment variables
# Copy to `.env` for local dev:  cp .env.example .env
# Deploy guide: docs/DEPLOY.md

# =============================================================================
# FRONTEND — Vite (embedded in the JS bundle; PUBLIC keys only)
# Set these in Vercel → Settings → Environment Variables (Production + Preview)
# =============================================================================

# Supabase — required for auth, database, storage, edge functions
# Use the legacy anon JWT (starts with eyJ…) — sb_publishable_* does NOT work with Edge Functions yet.
VITE_SUPABASE_URL=https://ixmbfnfwpjwbfahqaftc.supabase.co
VITE_SUPABASE_ANON_KEY=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Public site URL — referral links, OAuth redirects context
VITE_SITE_URL=https://propertyhub-2-0.vercel.app

# Stripe — client-side checkout (optional; live payments also need STRIPE_SECRET_KEY on Supabase)
VITE_STRIPE_PUBLISHABLE_KEY=

# PostHog — product analytics (optional)
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=https://us.i.posthog.com

# Firebase Cloud Messaging — browser push notifications (optional; pair with FCM_SERVER_KEY on Supabase)
VITE_FCM_VAPID_KEY=

# Google / Apple OAuth — configured in Supabase Dashboard → Authentication → Providers
# (no VITE_* keys; add redirect URL: https://your-domain.com/auth/callback)

# =============================================================================
# LOCAL CLI ONLY — never prefix with VITE_; do not commit real values
# =============================================================================

# Used by some Supabase CLI commands (db push, link)
SUPABASE_DB_PASSWORD=

# =============================================================================
# SUPABASE EDGE FUNCTION SECRETS
# Dashboard → Project → Edge Functions → Secrets
# (SUPABASE_URL, SUPABASE_ANON_KEY, SUPABASE_SERVICE_ROLE_KEY are injected automatically)
# =============================================================================

# --- Core ---
# SITE_URL=https://your-domain.com

# --- Payments (Paystack = Ghana/Africa; Stripe = international) ---
# PAYSTACK_SECRET_KEY=sk_live_...
# STRIPE_SECRET_KEY=sk_live_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# RAZORPAY_KEY_ID=rzp_live_...
# RAZORPAY_KEY_SECRET=...
# RAZORPAY_WEBHOOK_SECRET=...
# CRON_SECRET=...   # nightly analytics + utility billing cron

# --- Email (Resend) ---
# RESEND_API_KEY=re_...
# EMAIL_FROM=BaytMiftah <noreply@yourdomain.com>

# --- SMS / WhatsApp (Twilio — communications edge function) ---
# TWILIO_ACCOUNT_SID=AC...
# TWILIO_AUTH_TOKEN=...
# TWILIO_FROM_NUMBER=+1...

# --- AI (OpenAI — advisor, fraud scan, intelligence) ---
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini

# --- Push notifications (Firebase — push edge function) ---
# FCM_SERVER_KEY=...

# --- E-signatures (DocuSign — renter lease signing) ---
# DOCUSIGN_INTEGRATION_KEY=
# DOCUSIGN_ACCOUNT_ID=
# DOCUSIGN_USER_ID=
# DOCUSIGN_PRIVATE_KEY=
# DOCUSIGN_BASE_URL=https://demo.docusign.net/restapi

# --- Insurance partner API (insurance edge function) ---
# INSURANCE_PARTNER_API_KEY=
# INSURANCE_PARTNER_API_URL=https://api.partner.example.com

# --- Smart property / IoT (iot-webhook edge function) ---
# IOT_WEBHOOK_SECRET=

# Deploy backend: npm run deploy:backend

# =============================================================================
# CAPACITOR NATIVE APP (iOS / Android)
# Same VITE_* keys are baked into the native build at compile time.
# Guide: docs/CAPACITOR.md
# Workflow: npm run cap:sync  →  npm run cap:android  (or cap:ios on macOS)
# =============================================================================
