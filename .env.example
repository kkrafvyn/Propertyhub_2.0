# =============================================================================
# BaytMiftah — ALL environment variables (single file)
# Copy to .env and fill in values:
#   cp .env.example .env
#
# Vercel upload: paste only the VITE_* section into Project → Environment Variables
# Supabase deploy: npm run integrations:wire && npm run supabase:deploy:payments -- --skip-db
# =============================================================================

# ── Supabase project (required) ─────────────────────────────────────────────
SUPABASE_PROJECT_REF=
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_SUPABASE_PUBLISHABLE_KEY=

# ── Supabase CLI / database scripts ─────────────────────────────────────────
# Token: https://supabase.com/dashboard/account/tokens
SUPABASE_ACCESS_TOKEN=
SUPABASE_DB_PASSWORD=
SUPABASE_DB_REGION=eu-west-1
SUPABASE_DB_PORT=5432
# Optional full override:
# SUPABASE_DB_URL=postgresql://postgres.your-ref:password@aws-0-eu-west-1.pooler.supabase.com:5432/postgres
# Service role key — required for storage backups & admin scripts (never expose client-side)
SUPABASE_SERVICE_ROLE_KEY=

# ── App URLs & versioning (client / Vercel) ─────────────────────────────────
VITE_PUBLIC_APP_URL=https://baytmiftah.com
VITE_SITE_URL=https://baytmiftah.com
VITE_PROPERTY_MEDIA_BUCKET=property-media
VITE_APP_VERSION=1.0.0
VITE_APP_BUILD_NUMBER=1
VITE_APP_MINIMUM_VERSION=1.0.0
VITE_APP_MIN_VERSION=
VITE_APP_LATEST_VERSION=
VITE_APP_FORCE_UPDATE=false
VITE_APP_CHANGELOG=

# ── Native mobile store links (Capacitor) ───────────────────────────────────
VITE_IOS_APP_URL=
VITE_ANDROID_APP_URL=

# ── Paystack ────────────────────────────────────────────────────────────────
# Public  → VITE_PAYSTACK_PUBLIC_KEY  (pk_live_... / pk_test_...)
# Secret  → PAYSTACK_SECRET_KEY       (sk_live_... / sk_test_...)
# Webhook → PAYSTACK_WEBHOOK_SECRET   (from Paystack dashboard after registering URL)
# Webhook URL: https://ixmbfnfwpjwbfahqaftc.supabase.co/functions/v1/paystack-webhook
# Optional: leave empty to verify webhooks with PAYSTACK_SECRET_KEY instead
VITE_PAYSTACK_PUBLIC_KEY=
PAYSTACK_SECRET_KEY=
PAYSTACK_WEBHOOK_SECRET=

# ── Stripe ──────────────────────────────────────────────────────────────────
# Publishable → VITE_STRIPE_PUBLIC_KEY  (pk_live_...)
# Secret      → STRIPE_SECRET_KEY       (sk_live_...)
VITE_STRIPE_PUBLIC_KEY=
STRIPE_SECRET_KEY=

# ── Web push (VAPID) ────────────────────────────────────────────────────────
# Run npm run integrations:wire to auto-generate the pair if empty
VITE_WEB_PUSH_PUBLIC_KEY=
WEB_PUSH_PUBLIC_KEY=
WEB_PUSH_PRIVATE_KEY=
WEB_PUSH_CONTACT_EMAIL=mailto:support@baytmiftah.com

# ── Email (Resend) ──────────────────────────────────────────────────────────
RESEND_API_KEY=
NOTIFICATION_EMAIL_FROM=noreply@baytmiftah.com
NOTIFICATION_EMAIL_REPLY_TO=support@baytmiftah.com

# ── Automations (cron / internal dispatch) ───────────────────────────────────
# Auto-generated by npm run integrations:wire if empty
INTERNAL_AUTOMATIONS_KEY=

# ── App URL for server callbacks (Supabase Edge) ─────────────────────────────
PUBLIC_APP_URL=https://baytmiftah.com

# ── Exchange rates (optional) ───────────────────────────────────────────────
VITE_EXCHANGE_RATE_API_KEY=

# ── Integration flags (auto-set by npm run integrations:wire) ───────────────
VITE_OPENAI_ENABLED=
VITE_RESEND_CONFIGURED=

# ── AI (optional — works without keys using guided help) ───────────────────────
# Leave empty for guided FAQ + local search parsing. Set key for smart mode.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Auto-set to true by npm run integrations:wire when OPENAI_API_KEY is present
VITE_OPENAI_ENABLED=

# ── MLS / listing syndication (optional) ─────────────────────────────────────
MLS_API_KEY=
MLS_API_SECRET=
ZILLOW_API_KEY=
REALTOR_API_KEY=

# ── Twilio SMS/WhatsApp (optional) ──────────────────────────────────────────
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_PHONE_NUMBER=
# TWILIO_SMS_FROM=
# TWILIO_WHATSAPP_FROM=

# ── Blockchain contract addresses (after Hardhat deploy) ─────────────────────
VITE_PROPERTY_TOKEN_ADDRESS=
VITE_PROPERTY_ESCROW_ADDRESS=
VITE_PROPERTY_OWNERSHIP_ADDRESS=
VITE_PROPERTY_LEASE_ADDRESS=
VITE_VERIFICATION_REGISTRY_ADDRESS=
