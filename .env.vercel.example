# =============================================================================
# Vercel Production — confirmed vars (krafvyn/baytmiftah)
# Paste into Project → Settings → Environment Variables → Production
# Pull live copy: npx vercel env pull .env.vercel.production --environment=production
# =============================================================================

# ── Supabase (required) ──────────────────────────────────────────────────────
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_SUPABASE_PUBLISHABLE_KEY=

# ── App URLs ─────────────────────────────────────────────────────────────────
VITE_PUBLIC_APP_URL=https://baytmiftah.com
VITE_SITE_URL=https://baytmiftah.com
VITE_PROPERTY_MEDIA_BUCKET=property-media

# ── App versioning ───────────────────────────────────────────────────────────
VITE_APP_VERSION=1.0.0
VITE_APP_BUILD_NUMBER=1
VITE_APP_MINIMUM_VERSION=1.0.0
VITE_APP_MIN_VERSION=1.0.0
VITE_APP_LATEST_VERSION=1.0.0
VITE_APP_FORCE_UPDATE=false

# ── Paystack public (pk_live_...) ────────────────────────────────────────────
VITE_PAYSTACK_PUBLIC_KEY=

# ── Stripe publishable (pk_live_...) — add when ready ──────────────────────────
VITE_STRIPE_PUBLIC_KEY=

# ── Web push public VAPID (must match supabase/.env.payments) ─────────────────
VITE_WEB_PUSH_PUBLIC_KEY=

# ── Exchange rates ───────────────────────────────────────────────────────────
VITE_EXCHANGE_RATE_API_KEY=

# ── Feature flags (set true when server secret configured) ───────────────────
VITE_OPENAI_ENABLED=
VITE_RESEND_CONFIGURED=

# ── Blockchain (after deploy) ──────────────────────────────────────────────
VITE_PROPERTY_TOKEN_ADDRESS=
VITE_PROPERTY_ESCROW_ADDRESS=
VITE_PROPERTY_OWNERSHIP_ADDRESS=
VITE_PROPERTY_LEASE_ADDRESS=
VITE_VERIFICATION_REGISTRY_ADDRESS=

# DO NOT add server secrets (sk_*, PAYSTACK_SECRET_KEY, etc.) to Vercel.
