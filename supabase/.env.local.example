# Copy to supabase/.env.local (gitignored) for direct DB access from scripts/supabase-db.mjs
SUPABASE_PROJECT_REF=your-project-ref
SUPABASE_DB_PASSWORD=your-database-password
SUPABASE_DB_REGION=eu-west-1
SUPABASE_DB_PORT=5432

# Optional: full connection string overrides the fields above
# SUPABASE_DB_URL=postgresql://postgres.your-ref:password@aws-0-eu-west-1.pooler.supabase.com:5432/postgres

# Optional: enables `npx supabase link`, `db push`, and function deploy via CLI
# SUPABASE_ACCESS_TOKEN=your-personal-access-token
