# =============================================================================
# BaytMiftah — SERVER secrets template (Supabase Edge Functions)
# Copy to supabase/.env.payments and fill in values.
#
#   cp supabase/.env.payments.example supabase/.env.payments
#
# Public/client keys live in root .env (VITE_*). Never put sk_* keys there.
# Deploy: npm run supabase:deploy:payments -- --skip-db
# Sync:   npm run integrations:wire
# =============================================================================

# ── App URL (payment callbacks & email links) ────────────────────────────────
PUBLIC_APP_URL=https://baytmiftah.com

# ── Paystack — SECRET key + webhook ───────────────────────────────────────────
# Dashboard → Settings → API Keys & Webhooks
#   Public  → root .env → VITE_PAYSTACK_PUBLIC_KEY  (pk_live_...)
#   Secret  → PAYSTACK_SECRET_KEY                   (sk_live_...)
#   Webhook → PAYSTACK_WEBHOOK_SECRET (after registering webhook URL)
# Webhook URL: https://<project-ref>.supabase.co/functions/v1/paystack-webhook
PAYSTACK_SECRET_KEY=
PAYSTACK_WEBHOOK_SECRET=

# ── Stripe — SECRET key ──────────────────────────────────────────────────────
# Dashboard → Developers → API keys
#   Publishable → root .env → VITE_STRIPE_PUBLIC_KEY  (pk_live_...)
#   Secret      → STRIPE_SECRET_KEY                     (sk_live_...)
STRIPE_SECRET_KEY=

# ── Automations (cron / internal dispatch auth) ──────────────────────────────
# Auto-generated by npm run integrations:wire if empty
INTERNAL_AUTOMATIONS_KEY=

# ── Email — Resend ───────────────────────────────────────────────────────────
# https://resend.com/api-keys
RESEND_API_KEY=
NOTIFICATION_EMAIL_FROM=noreply@baytmiftah.com
NOTIFICATION_EMAIL_REPLY_TO=support@baytmiftah.com

# ── Web push — VAPID key pair ────────────────────────────────────────────────
# Public → root .env → VITE_WEB_PUSH_PUBLIC_KEY (auto-synced by integrations:wire)
WEB_PUSH_PUBLIC_KEY=
WEB_PUSH_PRIVATE_KEY=
WEB_PUSH_CONTACT_EMAIL=mailto:support@baytmiftah.com

# ── AI search (optional) ─────────────────────────────────────────────────────
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ── MLS / listing syndication (optional) ─────────────────────────────────────
MLS_API_KEY=
MLS_API_SECRET=
ZILLOW_API_KEY=
REALTOR_API_KEY=

# ── Twilio SMS/WhatsApp (optional) ───────────────────────────────────────────
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_PHONE_NUMBER=
# TWILIO_SMS_FROM=
# TWILIO_WHATSAPP_FROM=
