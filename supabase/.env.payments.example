PUBLIC_APP_URL=http://localhost:5173
VITE_PUBLIC_APP_URL=http://localhost:5173

# Paystack (required for live checkout)
PAYSTACK_SECRET_KEY=
PAYSTACK_WEBHOOK_SECRET=

# Automations cron auth
INTERNAL_AUTOMATIONS_KEY=

# Email (Resend)
RESEND_API_KEY=
NOTIFICATION_EMAIL_FROM=
NOTIFICATION_EMAIL_REPLY_TO=

# SMS / WhatsApp (Twilio)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
TWILIO_SMS_FROM=
TWILIO_WHATSAPP_FROM=

# Web push (must match VITE_WEB_PUSH_PUBLIC_KEY in root .env)
WEB_PUSH_PUBLIC_KEY=
WEB_PUSH_PRIVATE_KEY=
WEB_PUSH_CONTACT_EMAIL=mailto:support@propertyhub.app

# AI natural-language search (optional — falls back to local parser)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
